{
  "name": "koci",
  "version": "0.0.0",
  "description": "Koci (@koci/*) - directus extensions monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "link": "turbo run link",
    "validate": "turbo run validate",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish",
    "docker:up": "docker compose -f ./dev/docker-compose.yml up -d",
    "docker:down": "docker compose -f ./dev/docker-compose.yml down",
    "docker:restart": "docker compose -f ./dev/docker-compose.yml --env-file ./dev/.env restart",
    "docker:logs": "docker compose -f ./dev/docker-compose.yml logs -f directus"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.1.1",
    "eslint": "^9.39.5",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.13.0+sha512.1e55719bf26e809dce5c5084fdebaa64efb3da9038ae5d68a9f8a68311f1a45841c8c3b76a37298c3b66f6bcc80409a9b7f33c78a7168a3e90fb65a5d8235ae4"
}
