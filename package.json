{
  "name": "tepungpelita",
  "version": "0.0.0",
  "private": true,
  "description": "Tepung Pelita (@tepungpelita/*) - Directus extensions and Strapi plugins monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "link": "turbo run link",
    "lint": "eslint .",
    "validate": "turbo run validate",
    "test": "turbo run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "docker:up:directus": "docker compose -f ./dev/directus/docker-compose.yml up -d",
    "docker:down:directus": "docker compose -f ./dev/directus/docker-compose.yml down",
    "docker:restart:directus": "docker compose -f ./dev/directus/docker-compose.yml --env-file ./dev/directus/.env restart",
    "docker:logs:directus": "docker compose -f ./dev/directus/docker-compose.yml logs -f directus",
    "docker:up:strapi": "docker compose -f ./dev/strapi/docker-compose.yml up -d",
    "docker:down:strapi": "docker compose -f ./dev/strapi/docker-compose.yml down",
    "docker:restart:strapi": "docker compose -f ./dev/strapi/docker-compose.yml --env-file ./dev/strapi/.env restart",
    "docker:logs:strapi": "docker compose -f ./dev/strapi/docker-compose.yml logs -f strapi"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@lanun/eslint-config": "^0.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "turbo": "^2.11.9",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
