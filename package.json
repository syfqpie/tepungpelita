{
  "name": "koci",
  "version": "0.0.0",
  "description": "Koci (@koci/*) - directus extensions monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "link": "turbo run link",
    "validate": "turbo run validate",
    "docker:up": "docker compose -f ./dev/docker-compose.yml up -d",
    "docker:down": "docker compose -f ./dev/docker-compose.yml down",
    "docker:restart": "docker compose -f ./dev/docker-compose.yml --env-file ./dev/.env restart",
    "docker:logs": "docker compose -f ./dev/docker-compose.yml logs -f directus"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.1",
    "eslint": "^9.39.5",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.17.0"
}
