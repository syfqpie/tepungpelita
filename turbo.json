{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "link": {
      "dependsOn": ["^link"]
    },
    "validate": {
      "dependsOn": ["^validate"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
