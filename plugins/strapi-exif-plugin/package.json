{
  "name": "@tepungpelita/strapi-exif-plugin",
  "version": "0.1.0",
  "description": "Extract EXIF metadata from uploaded images and store it in Strapi.",
  "license": "MIT",
  "author": "syfqpie",
  "homepage": "https://github.com/syfqpie/tepungpelita/tree/main/plugins/strapi-exif-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syfqpie/tepungpelita.git",
    "directory": "plugins/strapi-exif-plugin"
  },
  "bugs": {
    "url": "https://github.com/syfqpie/tepungpelita/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "strapi",
    "strapi-plugin",
    "exif",
    "metadata",
    "images"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "dev": "strapi-plugin watch",
    "test": "vitest run",
    "verify": "strapi-plugin verify"
  },
  "dependencies": {
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "exifr": "^7.1.3"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.58.0",
    "@strapi/typescript-utils": "^5.58.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.6.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "exif",
    "displayName": "EXIF Metadata",
    "description": "Extract EXIF metadata from uploaded images and store it in Strapi."
  }
}
