{
	"name": "@tepungpelita/strapi-exif-plugin",
	"version": "0.0.0",
	"description": "Extract EXIF metadata from uploaded images and store it in Strapi.",
	"license": "MIT",
	"author": "syfqpie",
	"homepage": "https://github.com/syfqpie/tepungpelita/tree/main/plugins/strapi-exif-plugin#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/syfqpie/tepungpelita.git",
		"directory": "plugins/strapi-exif-plugin"
	},
	"bugs": {
		"url": "https://github.com/syfqpie/tepungpelita/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"strapi",
		"strapi-plugin",
		"exif",
		"metadata",
		"images"
	],
	"type": "commonjs",
	"exports": {
		"./package.json": "./package.json",
		"./strapi-server": {
			"types": "./dist/server/src/index.d.ts",
			"source": "./server/src/index.ts",
			"import": "./dist/server/index.mjs",
			"require": "./dist/server/index.js",
			"default": "./dist/server/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "strapi-plugin build",
		"dev": "strapi-plugin watch",
		"test": "vitest run",
		"verify": "strapi-plugin verify"
	},
	"dependencies": {
		"exifr": "^7.1.3"
	},
	"devDependencies": {
		"@strapi/sdk-plugin": "^6.1.1",
		"@strapi/strapi": "^5.58.0",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"@strapi/strapi": "^5.0.0"
	},
	"strapi": {
		"kind": "plugin",
		"name": "exif",
		"displayName": "EXIF Metadata",
		"description": "Extract EXIF metadata from uploaded images and store it in Strapi."
	}
}
