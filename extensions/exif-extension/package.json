{
	"name": "@tepungpelita/directus-exif-extension",
	"description": "Import files with EXIF metadata and manage them in Directus.",
	"icon": "extension",
	"version": "0.1.0",
	"license": "MIT",
	"author": "syfqpie",
	"homepage": "https://github.com/syfqpie/tepungpelita/tree/main/extensions/exif-extension#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/syfqpie/tepungpelita.git",
		"directory": "extensions/exif-extension"
	},
	"bugs": {
		"url": "https://github.com/syfqpie/tepungpelita/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle",
		"exif",
		"metadata",
		"images"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "hook",
				"name": "exif-import",
				"source": "src/hooks/exif-import/index.ts"
			}
		],
		"host": "^10.10.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate",
		"test": "vitest run",
		"add": "directus-extension add"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "18.0.6",
		"@directus/types": "^18.0.0",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"exifr": "^7.1.3"
	}
}
